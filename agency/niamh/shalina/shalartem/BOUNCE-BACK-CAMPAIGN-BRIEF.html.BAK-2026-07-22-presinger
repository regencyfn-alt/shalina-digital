<style>
  :root{
    --blue:#1F4598; --blue-900:#15306B; --orange:#F17025; --orange-700:#C9531A;
    --sky:#55B8ED; --parchment:#F7EFE0; --parchment-deep:#EFE3CC; --parchment-edge:#E4D6BC;
    --paper:#FBF7EF; --charcoal:#1A1A1A; --ink-500:#4A4A4A; --ink-300:#7C7A75;
    --gold:#C68A1E; --gold-bright:#D98600; --border-soft:#E3E0D9; --divider:#E7E3DB;
    --ok:#1F8A5B; --warn:#F17025;
    --font-display:'Playfair Display',Georgia,serif;
    --font-text:'Source Sans 3','Segoe UI',system-ui,sans-serif;
    --font-mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;
    --shadow-sm:0 2px 6px rgba(26,26,26,.07);
    --shadow-md:0 8px 22px rgba(26,26,26,.10);
    --shadow-card:0 10px 30px rgba(31,48,107,.10);
    --ease:cubic-bezier(.22,.61,.36,1);
  }
  *{box-sizing:border-box;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  html{scroll-behavior:smooth}
  body{
    margin:0; background:var(--parchment); color:var(--charcoal);
    font-family:var(--font-text); font-size:17px; line-height:1.55;
  }
  .wrap{max-width:1080px;margin:0 auto;padding:0 32px}
  .eyebrow{
    font-family:var(--font-text);font-weight:600;font-size:.72rem;
    letter-spacing:.22em;text-transform:uppercase;color:var(--orange);margin:0 0 14px
  }
  .eyebrow.blue{color:var(--blue)}
  .eyebrow.muted{color:var(--ink-300)}
  h1,h2,h3{font-family:var(--font-display);letter-spacing:-.015em;margin:0}
  h2{font-size:2.5rem;font-weight:700;line-height:1.1;color:var(--blue-900)}
  h3{font-size:1.4rem;font-weight:600;line-height:1.2;color:var(--charcoal)}
  .gold{color:var(--gold)}
  .orange{color:var(--orange)}
  .blue{color:var(--blue)}
  p{margin:0 0 16px;text-wrap:pretty}
  a{color:var(--blue);text-underline-offset:2px}
  strong{font-weight:700}

  /* ---- MASTHEAD ---- */
  header.mast{
    background:
      radial-gradient(120% 80% at 78% 12%, rgba(85,184,237,.10) 0%, rgba(85,184,237,0) 55%),
      linear-gradient(180deg,var(--paper) 0%, var(--parchment) 100%);
    border-bottom:1px solid var(--parchment-edge);
    padding:70px 0 54px;
  }
  .kicker{
    font-family:var(--font-text);font-weight:600;font-size:.72rem;letter-spacing:.28em;
    text-transform:uppercase;color:var(--ink-300);margin:0 0 22px
  }
  .kicker b{color:var(--blue);font-weight:700}
  h1.title{
    font-family:var(--font-display);font-weight:900;font-size:5.4rem;line-height:.94;
    letter-spacing:-.02em;color:var(--charcoal);margin:0
  }
  .subhead{
    font-family:var(--font-display);font-weight:500;font-size:2rem;line-height:1.15;
    color:var(--charcoal);margin:18px 0 20px
  }
  .lede{font-size:1.2rem;line-height:1.5;color:var(--ink-500);max-width:640px;margin:0}

  /* at-a-glance strip */
  .glance{
    display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
    background:var(--parchment-edge);border:1px solid var(--parchment-edge);
    margin:44px 0 0
  }
  .glance div{background:var(--paper);padding:18px 20px}
  .glance .k{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-300);font-weight:600;margin:0 0 6px}
  .glance .v{font-family:var(--font-display);font-weight:700;font-size:1.5rem;color:var(--blue-900);line-height:1.05}
  .glance .v small{display:block;font-family:var(--font-text);font-weight:500;font-size:.8rem;color:var(--ink-500);letter-spacing:0;margin-top:3px}

  /* ---- VERDICT / summary bar ---- */
  .verdict{
    background:var(--blue-900);color:#F4F1EA;padding:30px 0;
  }
  .verdict .wrap{display:flex;align-items:baseline;gap:22px;flex-wrap:wrap}
  .verdict .badge{
    font-family:var(--font-text);font-weight:700;font-size:.72rem;letter-spacing:.18em;
    text-transform:uppercase;color:#0e1f47;background:var(--gold-bright);
    padding:7px 14px;border-radius:2px;white-space:nowrap
  }
  .verdict p{margin:0;color:#DCE4F5;font-size:1.05rem;max-width:760px;line-height:1.45}
  .verdict b{color:#fff}

  /* ---- sections ---- */
  section{padding:62px 0;border-bottom:1px solid var(--divider)}
  section.tint{background:var(--parchment-deep)}
  .sec-head{margin:0 0 34px}
  .sec-head h2{margin-top:6px}

  .twocol{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
  .biglead{
    font-family:var(--font-display);font-weight:600;font-size:1.9rem;line-height:1.2;color:var(--charcoal)
  }

  /* count motif */
  .counts{display:flex;align-items:flex-end;gap:14px;height:150px;margin-top:8px}
  .counts .bar{width:52px;background:var(--parchment-edge);position:relative;border-radius:2px 2px 0 0}
  .counts .bar span{position:absolute;bottom:-26px;left:0;right:0;text-align:center;font-family:var(--font-mono);font-size:.82rem;color:var(--ink-300)}
  .counts .bar.b1{height:46%} .counts .bar.b2{height:38%} .counts .bar.b3{height:30%}
  .counts .bar.b4{height:100%;background:var(--gold)}
  .counts .bar.b4 span{color:var(--gold);font-weight:600}

  /* step cards */
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .card{
    background:var(--paper);border:1px solid var(--border-soft);border-radius:12px;
    padding:26px 24px;box-shadow:var(--shadow-sm)
  }
  .card .num{font-family:var(--font-display);font-weight:700;font-size:2rem;color:var(--gold);line-height:1;margin:0 0 14px}
  .card h4{font-family:var(--font-text);font-weight:700;font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;color:var(--blue);margin:0 0 10px}
  .card p{font-size:.98rem;color:var(--ink-500);margin:0}

  /* tiers */
  .tier{display:grid;grid-template-columns:180px 1fr;gap:26px;padding:26px 0;border-top:1px solid var(--divider)}
  .tier:first-of-type{border-top:none}
  .tier .tag{font-family:var(--font-display);font-weight:700;font-size:1.25rem;color:var(--blue-900)}
  .tier .tag small{display:block;font-family:var(--font-text);font-weight:600;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);margin-bottom:6px}
  .tier p{margin:0;color:var(--ink-500);font-size:1rem}

  /* cycle steps */
  .cycle{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;counter-reset:c}
  .cycle .st{background:var(--paper);border:1px solid var(--border-soft);border-radius:10px;padding:20px 18px;position:relative;box-shadow:var(--shadow-sm)}
  .cycle .st .d{font-family:var(--font-text);font-weight:700;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);margin:0 0 8px}
  .cycle .st h4{font-family:var(--font-display);font-weight:600;font-size:1.1rem;color:var(--blue-900);margin:0 0 8px}
  .cycle .st p{margin:0;font-size:.9rem;color:var(--ink-500)}

  /* tables */
  table{width:100%;border-collapse:collapse;font-size:.98rem;background:var(--paper);border:1px solid var(--border-soft)}
  th,td{text-align:left;padding:14px 18px;border-bottom:1px solid var(--divider);vertical-align:top}
  thead th{background:var(--blue-900);color:#EAF0FB;font-family:var(--font-text);font-weight:600;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}
  tbody tr:last-child td{border-bottom:none}
  td.amt{font-family:var(--font-mono);font-weight:600;color:var(--blue-900);white-space:nowrap}
  tr.sub td{background:#F1EADB;font-weight:600;font-size:.86rem}
  tr.sub td.amt{color:var(--blue-900)}
  tr.total td{background:var(--parchment-deep);font-weight:700}
  tr.total td.amt{color:var(--orange-700);font-size:1.05rem}
  .weeknum{font-family:var(--font-display);font-weight:700;color:var(--gold);white-space:nowrap}
  .rise td{box-shadow:inset 3px 0 0 var(--blue)}

  /* moment made hero */
  .hero-prize{display:grid;grid-template-columns:1fr 1.2fr;gap:44px;align-items:center}
  .hero-prize .big{font-family:var(--font-display);font-weight:800;font-size:4rem;line-height:.95;color:var(--gold);letter-spacing:-.02em}
  .hero-prize .lbl{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-300);font-weight:600;margin-top:14px}
  .podium{display:flex;gap:14px;margin-top:26px}
  .podium div{flex:1;background:var(--paper);border:1px solid var(--border-soft);border-radius:10px;padding:16px 14px;text-align:center;box-shadow:var(--shadow-sm)}
  .podium .p{font-family:var(--font-display);font-weight:700;font-size:1.5rem;color:var(--blue-900)}
  .podium .r{font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-300);font-weight:600;margin-top:4px}
  .podium .win1 .p{color:var(--gold)}

  /* checklist */
  ul.check{list-style:none;padding:0;margin:0;display:grid;gap:12px}
  ul.check li{position:relative;padding-left:34px;color:var(--ink-500);font-size:1rem}
  ul.check li::before{content:"";position:absolute;left:0;top:3px;width:20px;height:20px;border-radius:50%;border:2px solid var(--ok)}
  ul.check li.done::before{background:var(--ok);border-color:var(--ok)}
  ul.check li.gate::before{border-color:var(--orange);border-style:solid}
  ul.check li b{color:var(--charcoal)}
  ul.check li .flag{display:inline-block;font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:2px 8px;border-radius:3px;margin-left:8px;vertical-align:middle}
  ul.check li .flag.g{background:#E7F3EC;color:var(--ok)}
  ul.check li .flag.o{background:#FDEDE2;color:var(--orange-700)}

  /* compliance grid */
  .comp{display:grid;grid-template-columns:1fr 1fr;gap:14px 32px}
  .comp .item{display:flex;gap:12px;font-size:.96rem;color:var(--ink-500);padding:10px 0;border-bottom:1px solid var(--divider)}
  .comp .item b{color:var(--charcoal);font-weight:600}
  .comp .n{font-family:var(--font-mono);color:var(--blue);font-weight:600;flex:none}

  .note{background:var(--paper);border-left:3px solid var(--orange);padding:18px 22px;border-radius:0 8px 8px 0;box-shadow:var(--shadow-sm);margin-top:8px}
  .note p{margin:0;font-size:.98rem;color:var(--ink-500)}
  .note b{color:var(--charcoal)}
  .note.blue{border-left-color:var(--blue)}

  /* footer */
  footer{background:var(--charcoal);color:#F4F1EA;padding:52px 0 40px;text-align:center}
  footer .claim{font-family:var(--font-display);font-weight:700;font-size:1.7rem;color:#fff}
  footer .claim .gold{color:var(--gold)}
  footer .claim em{font-style:italic;font-weight:500;color:#D8D3C8}
  footer .fine{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:#8b8880;margin-top:20px}

  :root{ --shadow-lg:0 18px 48px rgba(26,26,26,.14); }
  .mast-top{display:grid;grid-template-columns:1.32fr .9fr;gap:46px;align-items:center;margin-bottom:8px}
  .mast-art{margin:0;position:relative}
  .mast-art img{width:100%;height:auto;display:block;border-radius:0;border:1px solid var(--parchment-edge);box-shadow:var(--shadow-lg)}
  .mast-art figcaption{font-family:var(--font-text);font-weight:600;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-300);margin-top:12px;text-align:right}
  .phone{margin:0 auto;max-width:290px;text-align:center}
  .phone video{width:100%;height:auto;display:block;border-radius:26px;background:#0b0d12;border:7px solid #12151b;box-shadow:var(--shadow-lg)}
  .phone figcaption{font-family:var(--font-text);font-size:.82rem;color:var(--ink-500);margin-top:14px;line-height:1.4}
  .phone .cue{display:inline-block;font-size:.64rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);background:#FDEDE2;padding:3px 10px;border-radius:3px;margin-bottom:8px}

  @media(max-width:820px){
    .wrap{padding:0 22px}
    h1.title{font-size:3.3rem}
    .subhead{font-size:1.5rem}
    h2{font-size:1.9rem}
    .glance{grid-template-columns:repeat(2,1fr)}
    .twocol,.steps,.hero-prize,.comp{grid-template-columns:1fr;gap:26px}
    .cycle{grid-template-columns:1fr 1fr}
    .tier{grid-template-columns:1fr;gap:8px}
    .verdict .wrap{gap:14px}
  }
</style>
</head>
